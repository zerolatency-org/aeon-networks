{
	"name": "aeon",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.3",
			"varlock": "1.23.0",
			"@orpc/server": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.12",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @aeon/db --",
		"db:studio": "turbo run db:studio -F @aeon/db --",
		"db:generate": "turbo run db:generate -F @aeon/db --",
		"db:migrate": "turbo run db:migrate -F @aeon/db --",
		"db:start": "turbo run db:start -F @aeon/db --",
		"db:watch": "turbo run db:watch -F @aeon/db --",
		"db:stop": "turbo run db:stop -F @aeon/db --",
		"db:down": "turbo run db:down -F @aeon/db --",
		"env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write .",
		"test": "turbo run test",
		"check:ci": "biome ci ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aeon/config": "workspace:*",
		"@biomejs/biome": "^2.6.2",
		"@types/bun": "catalog:",
		"lefthook": "^2.2.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:",
		"viem": "2.57.16"
	},
	"packageManager": "bun@1.4.4"
}
