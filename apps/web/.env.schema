# apps/web/.env.schema
# Every setting the web app reads. `bun run env:check` validates .env against
# this file (varlock, as in apps/server). Next.js still loads .env on its own.
# @defaultRequired=false @defaultSensitive=false
# ---

# Where Next.js forwards /api and /rpc. Server side only, so no NEXT_PUBLIC_ prefix.
# @type=url
# @required
API_URL=http://localhost:3000

# The API origin the browser is told about.
# @type=url
NEXT_PUBLIC_API_URL=http://localhost:3000

# 0G Galileo RPC. The public one is for development only.
# @type=url
NEXT_PUBLIC_RPC_URL=https://evmrpc-testnet.0g.ai

# @type=url
NEXT_PUBLIC_EXPLORER_URL=https://chainscan-galileo.0g.ai

# Free project id from https://cloud.reown.com. Without it MetaMask still works,
# but WalletConnect and mobile wallets do not.
# @required
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
