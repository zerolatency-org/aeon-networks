# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# --- Aeon additions (P1) ---

# Chain the SIWE message must name. 16602 = 0G Galileo testnet.
# @public @type=number
OG_CHAIN_ID=16602

# Must match the host the wallet signs for (host[:port], no scheme).
# @public
SIWE_DOMAIN=localhost:3000

# OAuth apps. Leave empty to switch a provider off.
# @optional @public
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=
# @optional
GITHUB_CLIENT_ID=
# @optional
GITHUB_CLIENT_SECRET=

# Comma-separated lowercase wallet addresses allowed on admin routes.
# @optional @public
ADMIN_WALLETS=

# --- Aeon additions (P4) ---

# JSON-RPC endpoint the worker reads the chain from.
# @public @type=url
OG_RPC_URL=https://evmrpc-testnet.0g.ai

# Written by packages/contracts/script/Deploy.s.sol. Relative to apps/server.
# @public
DEPLOYMENT_FILE=../../packages/contracts/deployments/galileo.json

# Blocks to wait before indexing a block (reorg safety).
# @public @type=number
INDEXER_CONFIRMATIONS=3

# Most blocks per getLogs call.
# @public @type=number
INDEXER_CHUNK_SIZE=1000

# --- Aeon additions (P6) ---

# 32 random bytes as hex (openssl rand -hex 32). Seals agent wallet keys and personas.
# Agent routes stay off (503) until this, ROUTER_API_KEY and DEPLOYMENT_FILE are set.
# @optional
MASTER_KEY=

# 0G Compute Router, OpenAI-compatible. Testnet endpoint by default.
# @public @type=url
ROUTER_BASE_URL=https://router-api-testnet.integratenetwork.work/v1

# Router API key (sk-...). Server-only; never sent to a browser.
# @optional
ROUTER_API_KEY=
# --- Aeon additions (P8) ---
# @public @type=number
MAILBOX_MAX_BYTES=1048576
# @public @type=number
MAILBOX_QUOTA_BYTES=16777216
# @optional
KEEPER_PRIVATE_KEY=
# @optional
STORAGE_PRIVATE_KEY=
# @public @type=url
OG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# --- Aeon additions (P9) ---

# The Aeon Verifier: a neutral evaluator wallet buyers can name instead of their own agent.
# Throwaway, lightly funded (it pays gas for complete/dispute). Off until set.
# @optional
AEON_VERIFIER_PRIVATE_KEY=
