# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# --- Aeon additions (P1) ---

# Chain the SIWE message must name. 16602 = 0G Galileo testnet.
# @public @type=number
OG_CHAIN_ID=16602

# Must match the host the wallet signs for (host[:port], no scheme).
# @public
SIWE_DOMAIN=localhost:3000

# OAuth apps. Leave empty to switch a provider off.
# @optional
GOOGLE_CLIENT_ID=
# @optional
GOOGLE_CLIENT_SECRET=
# @optional
GITHUB_CLIENT_ID=
# @optional
GITHUB_CLIENT_SECRET=

# Comma-separated lowercase wallet addresses allowed on admin routes.
# @optional @public
ADMIN_WALLETS=